# Advocat.ee production build environment
# Copy to .env.prod (gitignored) and fill in REAL values.
# These values are baked into main.dart.js at build time via --dart-define-from-file
#
# Source for each key:
#   SUPABASE_URL          = Supabase Dashboard > Project Settings > API > Project URL
#   SUPABASE_ANON_KEY     = Supabase Dashboard > Project Settings > API > anon public key
#                           (THIS IS THE MISSING KEY that broke prod on Apr 18 and Apr 20)
#   STRIPE_PUBLISHABLE_KEY= Stripe Dashboard > Developers > API keys > Publishable key
#                           Use the LIVE key (pk_live_...), not test.
#   STRIPE_MERCHANT_ID    = Apple Pay merchant id (optional; has working default)
#   PRODUCTION            = true for prod build, false otherwise
#
# Google OAuth: DO NOT add GOOGLE_CLIENT_ID here. OAuth is configured entirely
# server-side in Supabase Dashboard > Authentication > Providers > Google.

SUPABASE_URL=https://okgnkucgwsytsondrjye.supabase.co
SUPABASE_ANON_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_MERCHANT_ID=merchant.com.ailegaldefense
PRODUCTION=true
