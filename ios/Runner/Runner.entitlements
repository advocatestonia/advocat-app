<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  APNs environment for Firebase Cloud Messaging (Pkg 9 Deadline Radar
	  push channel).

	  Value 'development' covers debug + TestFlight builds.
	  Switch to 'production' for App Store releases via a separate
	  Release.entitlements file or build-configuration override.

	  Owner setup (one-time, not code-checked):
	    1. Apple Developer → Certificates, Identifiers & Profiles →
	       Keys → create an "APNs Authentication Key" (.p8).
	    2. Firebase Console → Project Settings → Cloud Messaging →
	       Apple app configuration → Upload the .p8 along with the
	       Key ID and Team ID.
	    3. Xcode → Runner target → Signing & Capabilities → '+ Capability'
	       → 'Push Notifications'. This step is what registers
	       Runner.entitlements with the project (it's already on disk —
	       the IDE just wires it into CODE_SIGN_ENTITLEMENTS).
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
