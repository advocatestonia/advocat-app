  "onboardingTitle1": "\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062d\u0642\u0648\u0642\u06cc \u0645\u0628\u062a\u0646\u06cc \u0628\u0631 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc",
  "onboardingDesc1": "Advocat \u0628\u0647 \u0634\u0645\u0627 \u06a9\u0645\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648\u0636\u0639\u06cc\u062a \u062d\u0642\u0648\u0642\u06cc \u062e\u0648\u062f \u0631\u0627 \u062f\u0631\u06a9 \u06a9\u0646\u06cc\u062f. \u0627\u0628\u0632\u0627\u0631\u0647\u0627\u06cc \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u0627\u0633\u0646\u0627\u062f \u0631\u0627 \u062a\u062d\u0644\u06cc\u0644 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u060c \u0645\u0634\u06a9\u0644\u0627\u062a \u0627\u062d\u062a\u0645\u0627\u0644\u06cc \u0631\u0627 \u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f \u0648 \u067e\u06cc\u0634\u200c\u0646\u0648\u06cc\u0633 \u0627\u0633\u0646\u0627\u062f \u0631\u0627 \u0628\u0631\u0627\u06cc \u0628\u0631\u0631\u0633\u06cc \u0634\u0645\u0627 \u0622\u0645\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f. \u0627\u06cc\u0646 \u06cc\u06a9 \u062f\u0641\u062a\u0631 \u0648\u06a9\u0627\u0644\u062a \u0646\u06cc\u0633\u062a \u2014 \u06cc\u06a9 \u0627\u0628\u0632\u0627\u0631 \u0641\u0646\u0627\u0648\u0631\u06cc \u0628\u0631\u0627\u06cc \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0627\u0632 \u067e\u0631\u0648\u0646\u062f\u0647 \u0634\u0645\u0627\u0633\u062a.",
  "onboardingTitle2": "\u0627\u0633\u06a9\u0646 \u0648 \u062a\u062d\u0644\u06cc\u0644 \u0627\u0633\u0646\u0627\u062f",
